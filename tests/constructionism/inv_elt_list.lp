// Invariant of interval lists and its Boolean equivalent.
//
// Coq original:
//
//   Inductive elt_list := Nil | Cons : Z -> Z -> elt_list -> elt_list.
//
//   Inductive Inv_elt_list : Z -> elt_list -> Prop :=
//   | invNil : forall b, Inv_elt_list b Nil
//   | invCons : forall (a b j : Z) (q : elt_list),
//       j <= a -> a <= b -> Inv_elt_list (b + 2) q ->
//       Inv_elt_list j (Cons a b q).
//
//   Lemma Inv_elt_list_decidable : forall b e,
//     Inv_elt_list b e <-> Inv_elt_list_bool b e = true.
//
// `Cons a b q` is the interval [a, b] followed by q. `Inv_elt_list j l` says
// that the intervals of l are well formed, sorted, start at j or later, and
// are separated by at least one missing integer (hence `b + 2`).
require open tests.OK.Set tests.OK.Prop tests.OK.FOL tests.OK.Eq
  tests.OK.Bool tests.OK.Comp tests.OK.Z;

inductive elt_list : TYPE ≔
| Nil : elt_list
| Cons : ℤ → ℤ → elt_list → elt_list;

// Inductive predicate. Lambdapi inductive types live in TYPE, so the
// inductive is Inv_elt_list_T and the Prop Inv_elt_list is defined by
// π (Inv_elt_list j l) ↪ Inv_elt_list_T j l. ind_Inv_elt_list_T is
// generated by the `inductive` command.
inductive Inv_elt_list_T : ℤ → elt_list → TYPE ≔
| invNil : Π b, Inv_elt_list_T b Nil
| invCons : Π (a b j : ℤ) (q : elt_list),
    π (j ≤ a) → π (a ≤ b) → Inv_elt_list_T (b + _2) q →
    Inv_elt_list_T j (Cons a b q);

constant symbol Inv_elt_list : ℤ → elt_list → Prop;
rule π (Inv_elt_list $j $l) ↪ Inv_elt_list_T $j $l;

// Boolean version.
//   Fixpoint Inv_elt_list_bool b l := match l with
//   | Nil => true
//   | Cons a c q => Z.leb b a && Z.leb a c && Inv_elt_list_bool (c + 2) q
//   end.

// Boolean ≤ on ℤ. Z.lp defines x ≤ y as ¬ istrue (isGt (x ≐ y)).
symbol leb (x y : ℤ) : 𝔹 ≔ not (isGt (x ≐ y));

opaque symbol leb_≤ [x y] : π (istrue (leb x y)) → π (x ≤ y) ≔
  λ h, istrue_not h;
opaque symbol ≤_leb [x y] : π (x ≤ y) → π (istrue (leb x y)) ≔
  λ h, ¬_istrue h;

symbol Inv_elt_list_bool : ℤ → elt_list → 𝔹;
rule Inv_elt_list_bool _ Nil ↪ true
with Inv_elt_list_bool $j (Cons $a $b $q) ↪
  (leb $j $a and leb $a $b) and Inv_elt_list_bool ($b + _2) $q;

// Inv_elt_list ⇒ bool = true, by induction on the derivation.
opaque symbol Inv_elt_list_bool_complete j l :
  π (Inv_elt_list j l ⇒ Inv_elt_list_bool j l = true) ≔
  ind_Inv_elt_list_T (λ j l _, Inv_elt_list_bool j l = true)
    (λ b, eq_refl true)
    (λ a b j q hja hab _ ih,
       istrue=true
         (@andᵢ (leb j a and leb a b) (Inv_elt_list_bool (b + _2) q)
            (@andᵢ (leb j a) (leb a b) (@≤_leb j a hja) (@≤_leb a b hab))
            (true=istrue ih)))
    j l;

// bool = true ⇒ Inv_elt_list, by induction on the list, for every start j.
opaque symbol Inv_elt_list_bool_sound l : Π j,
  π (Inv_elt_list_bool j l = true ⇒ Inv_elt_list j l) ≔
  ind_elt_list
    (λ l, `∀ j : τ int, Inv_elt_list_bool j l = true ⇒ Inv_elt_list j l)
    (λ j _, invNil j)
    (λ a b q ih j h,
       let hab : π (istrue (leb j a and leb a b)) ≔
         @andₑ₁ (leb j a and leb a b) (Inv_elt_list_bool (b + _2) q)
           (true=istrue h) in
       let hq : π (istrue (Inv_elt_list_bool (b + _2) q)) ≔
         @andₑ₂ (leb j a and leb a b) (Inv_elt_list_bool (b + _2) q)
           (true=istrue h) in
       invCons a b j q
         (@leb_≤ j a (@andₑ₁ (leb j a) (leb a b) hab))
         (@leb_≤ a b (@andₑ₂ (leb j a) (leb a b) hab))
         (ih (b + _2) (istrue=true hq)))
    l;

opaque symbol Inv_elt_list_decidable b e :
  π (Inv_elt_list b e ⇔ Inv_elt_list_bool b e = true) ≔
  ∧ᵢ (Inv_elt_list_bool_complete b e) (Inv_elt_list_bool_sound e b);

// Sanity checks: [0, 3] [5, 5] is valid from 0, [0, 3] [4, 5] is not
// (4 is adjacent to 3), and computation decides it.
assert ⊢ Inv_elt_list_bool Z0 (Cons Z0 _3 (Cons _5 _5 Nil)) ≡ true;
assert ⊢ Inv_elt_list_bool Z0 (Cons Z0 _3 (Cons _4 _5 Nil)) ≡ false;

opaque symbol example : π (Inv_elt_list Z0 (Cons Z0 _3 (Cons _5 _5 Nil))) ≔
  Inv_elt_list_bool_sound (Cons Z0 _3 (Cons _5 _5 Nil)) Z0 (eq_refl true);
