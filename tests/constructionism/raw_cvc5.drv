(* Option B of AGENTS.md: cvc5.drv without any transformation, so that the
   SMT-LIB problem is the Why3 task verbatim. Monomorphic tasks only. Imports
   are looked up here first, then in Why3's drivers directory. *)

prelude "(set-logic ALL)"
prelude "(set-info :smt-lib-version 2.6)"

import "smt-libv2.gen"
filename "%f-%t-%g.smt2"
printer "smtv2.6"
