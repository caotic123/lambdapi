(assume a0 p)
(assume a1 (! (=> p q) :named @p_1))
(assume a2 (! (not (! (or (! (and q p) :named @p_3) (! (not p) :named @p_2)) :named @p_4)) :named @p_5))
(step t0 (cl @p_4 (not @p_3)) :rule or_neg :args (0))
(step t1 (cl @p_2 q) :rule implies :premises (a1))
(step t2 (cl q) :rule resolution :premises (t1 a0) :args (p false))
(step t3 (cl @p_3) :rule and_intro :premises (t2 a0))
(step t4 (cl @p_4) :rule resolution :premises (t0 t3) :args (@p_3 false))
(step t5 (cl) :rule resolution :premises (t4 a2) :args (@p_4 true))
