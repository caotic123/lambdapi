(set-logic ALL)
(set-info :smt-lib-version 2.6)
;;; generated by SMT-LIB2 driver
(declare-sort nat 0)

;; "succ"
(declare-fun succ (nat) nat)

;; "zero"
(declare-fun zero () nat)

;; "even"
(declare-fun even (nat) Bool)

;; "q"
(declare-fun q () Bool)

;; "_"
(assert (forall ((n nat)) (=> (even n) (even (succ (succ n))))))

;; "_0"
(assert (even zero))

;; Goal "G"
(assert
  (not (and (even (succ (succ zero))) (=> q q))))

(check-sat)
