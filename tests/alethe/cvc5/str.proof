unsat
(
(assume a0 (! (= s "say ""hi""") :named @p_1))
(assume a1 (! (not (! (= (! (str.len s) :named @p_2) 8) :named @p_3)) :named @p_4))
(step t0 (cl (not (! (= @p_4 false) :named @p_5)) (not @p_4) false) :rule equiv_pos2)
(step t1 (cl (= @p_2 (! (str.len "say ""hi""") :named @p_6))) :rule cong :premises (a0))
(step t2 (cl (! (= 8 8) :named @p_11)) :rule refl)
(step t3 (cl (= @p_3 (! (= @p_6 8) :named @p_7))) :rule cong :premises (t1 t2))
(step t4 (cl (= @p_4 (! (not @p_7) :named @p_8))) :rule cong :premises (t3))
(step t5 (cl @p_7) :rule hole :args ("TRUST_THEORY_REWRITE" @p_7 12 7))
(step t6 (cl (= @p_7 @p_11)) :rule cong :premises (t5 t2))
(step t7 (cl (! (= @p_11 true) :named @p_12)) :rule hole :args ("TRUST_THEORY_REWRITE" @p_12 3 7))
(step t8 (cl (= @p_7 true)) :rule trans :premises (t6 t7))
(step t9 (cl (= @p_8 (! (not true) :named @p_9))) :rule cong :premises (t8))
(step t10 (cl (! (= @p_9 false) :named @p_10)) :rule hole :args ("TRUST_THEORY_REWRITE" @p_10 1 7))
(step t11 (cl (= @p_8 false)) :rule trans :premises (t9 t10))
(step t12 (cl @p_5) :rule trans :premises (t4 t11))
(step t13 (cl false) :rule resolution :premises (t0 t12 a1) :args (@p_5 false @p_4 false))
(step t14 (cl (not false)) :rule false)
(step t15 (cl) :rule resolution :premises (t13 t14) :args (false true))
)
