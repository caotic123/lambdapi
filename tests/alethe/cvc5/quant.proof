unsat
(
(assume a0 (forall ((x U)) (p x)))
(assume a1 (! (not (! (p a) :named @p_1)) :named @p_2))
(step t0 (cl (! (=> (forall ((x U)) (p x)) @p_1) :named @p_4) (forall ((x U)) (p x))) :rule implies_neg1)
(anchor :step t1)
(assume t1.a0 (forall ((x U)) (p x)))
(step t1.t0 (cl (or (! (not (forall ((x U)) (p x))) :named @p_3) @p_1)) :rule forall_inst :args (a))
(step t1.t1 (cl @p_3 @p_1) :rule or :premises (t1.t0))
(step t1.t2 (cl @p_1) :rule resolution :premises (t1.t1 t1.a0) :args ((forall ((x U)) (p x)) false))
(step t1 (cl @p_3 @p_1) :rule subproof :discharge (t1.a0))
(step t2 (cl @p_4 @p_1) :rule resolution :premises (t0 t1) :args ((forall ((x U)) (p x)) true))
(step t3 (cl @p_4 @p_2) :rule implies_neg2)
(step t4 (cl @p_4 @p_4) :rule resolution :premises (t2 t3) :args (@p_1 true))
(step t5 (cl @p_4) :rule contraction :premises (t4))
(step t6 (cl @p_3 @p_1) :rule implies :premises (t5))
(step t7 (cl @p_1 @p_3) :rule reordering :premises (t6))
(step t8 (cl) :rule resolution :premises (t7 a1 a0) :args (@p_1 true (forall ((x U)) (p x)) false))
)
