unsat
(
(assume a0 (! (= (bvadd x #b0001) #b0000) :named @p_1))
(assume a1 (! (not (! (= x #b1111) :named @p_2)) :named @p_3))
(step t0 (cl (not (! (= @p_1 @p_2) :named @p_4)) (not @p_1) @p_2) :rule equiv_pos2)
(step t1 (cl (! (= @p_1 (! (= #b1111 x) :named @p_5)) :named @p_7)) :rule hole :args ("PP_STATIC_REWRITE" "THEORY_SETS" @p_7))
(step t2 (cl (! (= @p_5 @p_2) :named @p_6)) :rule hole :args ("TRUST_THEORY_REWRITE" @p_6 4 6))
(step t3 (cl @p_4) :rule trans :premises (t1 t2))
(step t4 (cl @p_2) :rule resolution :premises (t0 t3 a0) :args (@p_4 false @p_1 false))
(step t5 (cl) :rule resolution :premises (t4 a1) :args (@p_2 true))
)
